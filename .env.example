# Relay backend
PORT=8787
PUBLIC_URL=http://localhost:8787
DATA_FILE=server/data/db.json

# 32-byte hex key used to encrypt Telegram StringSessions at rest.
# Generate: openssl rand -hex 32
SESSION_KEY=

# Demo mode: creates a fictional inbox with one tap, no credentials needed.
DEMO_ENABLED=true
DEMO_VOICE=true
CORS_ORIGIN=*

# Telegram MTProto (my.telegram.org → API development tools).
# Without these the app still runs in demo mode and the pair page explains why.
TG_API_ID=
TG_API_HASH=

# Optional LLM upgrade (OpenAI-compatible). Without a key, Relay uses its
# deterministic ask-extractor and reply drafter.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional speech-to-text. OpenAI Whisper API or a local whisper.cpp binary.
OPENAI_API_KEY=
STT_MODEL=whisper-1
WHISPER_BIN=
WHISPER_MODEL=models/ggml-base.en.bin
